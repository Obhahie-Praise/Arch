# Arch Web — Environment Variables
# Copy to .env.local for local development. Never commit real values.

# URL of the Cloudflare Worker API backend
# Local:      http://localhost:8787
# Production: https://api.obhahiepraise.workers.dev
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public URL of this web application.
# Used to build absolute OAuth callbackURLs so Better Auth redirects back
# to the frontend after a successful OAuth flow.
# Local:      http://localhost:3000
# Production: https://arch-eight-orcin.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
