# Production environment variables for Next.js build.
#
# Next.js loads this file automatically during `next build` when NODE_ENV=production.
# NEXT_PUBLIC_* values are inlined as string literals into the browser bundle at
# build time — they are not available at runtime via process.env in the browser.
#
# This file is safe to commit because it contains only the public API URL, which
# is already visible in every network request the browser makes.
#
# Do NOT add secrets here. Secrets belong in `wrangler secret put` or .env.local.

# URL of the API Worker. Used by:
#   - lib/api.ts        → API_URL constant (all data-fetching)
#   - lib/auth-client.ts → Better Auth client baseURL
#   - middleware.ts     → server-side session validation against the API
NEXT_PUBLIC_API_URL=https://api.obhahiepraise.workers.dev
