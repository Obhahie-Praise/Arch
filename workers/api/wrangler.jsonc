/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "arch_db",
			"database_name": "arch-db",
			"database_id": "d1673b96-693c-47e0-8122-b2f072ac96cf",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"ENVIRONMENT": "production",
		// APP_URL is the primary production frontend origin (Vercel).
		// Used by CORS allowlist and Better Auth trustedOrigins.
		"APP_URL": "https://arch-eight-orcin.vercel.app",
		// ADDITIONAL_ORIGINS is a comma-separated list of extra allowed origins.
		// The legacy Cloudflare frontend is preserved here for development/testing.
		"ADDITIONAL_ORIGINS": "https://arch.obhahiepraise.workers.dev"
	}
	/**
	 * Secrets / plain vars (set via `wrangler secret put` or Cloudflare dashboard):
	 *
	 * Already configured in production:
	 *   BETTER_AUTH_SECRET      — secret
	 *   BETTER_AUTH_URL         — https://api.obhahiepraise.workers.dev  (plain var)
	 *   APP_URL                 — https://arch-eight-orcin.vercel.app  (plain var, in vars above)
	 *   ADDITIONAL_ORIGINS      — https://arch.obhahiepraise.workers.dev  (plain var, in vars above)
	 *   UPLOADTHING_TOKEN       — secret
	 *   GOOGLE_CLIENT_ID        — secret
	 *   GOOGLE_CLIENT_SECRET    — secret
	 *   GITHUB_CLIENT_ID        — secret
	 *   GITHUB_CLIENT_SECRET    — secret
	 *   TAVILY_API_KEY          — secret
	 *   DEVELOPER_ACCESS_EMAIL  — plain var
	 *
	 * Optional:
	 *   INTERNAL_ENGINE_SECRET  — required for /api/internal/* in production
	 */
}