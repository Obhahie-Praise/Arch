# Arch Worker API — Local Development Variables
# Copy to .env and .dev.vars for local development.
# Never commit real values. Use `wrangler secret put` for production secrets.

# ── Required ─────────────────────────────────────────────────────────────────

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# URL this worker is served at
# Local: http://localhost:8787
# Production: https://api.arch.inc
BETTER_AUTH_URL=http://localhost:8787

# ── OAuth Providers (optional but recommended) ────────────────────────────────

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Production-only Variables ────────────────────────────────────────────────

# The public-facing web app URL. Required in production for CORS and auth.
# Example: https://arch.inc
# APP_URL=https://arch.inc

# Secret for /api/internal/* endpoints. Required in production.
# Generate with: openssl rand -hex 32
# INTERNAL_ENGINE_SECRET=your-internal-secret-here

# Tavily API key for web search discovery (https://tavily.com)
# TAVILY_API_KEY=your-tavily-api-key

# Set to 'production' when deployed
# ENVIRONMENT=production
